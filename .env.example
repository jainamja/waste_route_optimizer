# Flask Secret Key
SECRET_KEY=your-secure-flask-secret-key-here

# Firebase Realtime Database and Auth Configuration
FIREBASE_API_KEY=your-firebase-web-api-key-here
FIREBASE_DB_URL=https://your-firebase-project-default-rtdb.firebaseio.com

# Database Connection (defaults to local SQLite instance/routes.db if left unset)
DATABASE_URL=sqlite:///routes.db

# Optional Google Maps API Key for geocoding and traffic-aware distance matrix
# GMAPS_API_KEY=your-google-maps-api-key-here

# Port (optional, defaults to 5000)
PORT=5000
