# ----------------------------------------------------------------------------
# TrashTrekyx - Production / Environment Configuration Template
# ----------------------------------------------------------------------------
# Copy this file to .env and fill in the values for your deployment environment.
# Never commit .env or secrets to source control.

# Flask Application Secret Key (cryptographically secure random string)
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string

# Database Connection URL
# SQLite on Render Persistent Disk: sqlite:////var/data/routes.db
# PostgreSQL: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:////var/data/routes.db

# Admin Initial Password (used only if admin user does not already exist)
ADMIN_PASSWORD=replace_with_strong_admin_password

# Admin Reset Secret (required to reset admin password via /api/admin_reset_password)
ADMIN_RESET_SECRET=replace_with_strong_random_secret_token

# Firebase Realtime Database Web API Key (Google Identity Toolkit)
FIREBASE_API_KEY=replace_with_your_firebase_web_api_key

# Google Maps API Key (Optional, for Distance Matrix with traffic predictions)
# If omitted, system seamlessly falls back to OSRM / Geodesic distance matrices.
GMAPS_API_KEY=

# Server Port (set automatically by hosting provider such as Render or Heroku)
PORT=8000
