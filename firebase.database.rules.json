{
  "rules": {
    ".read": false,
    ".write": false,

    "trucks": {
      ".read": "auth != null && auth.token.role === 'ADMIN'",
      "$truckId": {
        ".read": "auth != null && (auth.token.role === 'ADMIN' || (auth.token.role === 'DRIVER' && auth.token.truck_id == $truckId))",
        ".write": "auth != null && (auth.token.role === 'ADMIN' || (auth.token.role === 'DRIVER' && auth.token.truck_id == $truckId))",
        
        "currentLat": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= -90 && newData.val() <= 90)" },
        "currentLng": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= -180 && newData.val() <= 180)" },
        "lat": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= -90 && newData.val() <= 90)" },
        "lng": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= -180 && newData.val() <= 180)" },
        "speed": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 300)" },
        "heading": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 360)" },
        "accuracy": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)" },
        "status": { ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'offline' || newData.val() === 'active')" },
        "lastUpdated": { ".validate": "newData.val() == null || newData.isNumber() || newData.isString()" },
        "timestamp": { ".validate": "newData.val() == null || newData.isNumber() || newData.isString()" },
        "truckId": { ".validate": "newData.val() == null || newData.val() == $truckId" },
        "driverId": { ".validate": "newData.val() == null || auth.token.role === 'ADMIN' || (auth.token.role === 'DRIVER' && auth.token.driver_id == newData.val())" },
        "driverName": { ".validate": "newData.val() == null || newData.isString()" },
        "name": { ".validate": "newData.val() == null || newData.isString()" },
        
        "latest_alert": {
          ".read": "auth != null && (auth.token.role === 'ADMIN' || (auth.token.role === 'DRIVER' && auth.token.truck_id == $truckId))",
          ".write": "auth != null && (auth.token.role === 'ADMIN' || (auth.token.role === 'DRIVER' && auth.token.truck_id == $truckId))",
          "read": { ".validate": "newData.isBoolean()" },
          "text": { ".validate": "auth.token.role === 'ADMIN' ? newData.isString() : data.val() === newData.val()" },
          "timestamp": { ".validate": "newData.isNumber()" }
        }
      }
    },

    "driver_locations": {
      ".read": "auth != null && auth.token.role === 'ADMIN'",
      "$driverId": {
        ".read": "auth != null && (auth.token.role === 'ADMIN' || (auth.token.role === 'DRIVER' && auth.token.driver_id == $driverId))",
        ".write": "auth != null && (auth.token.role === 'ADMIN' || (auth.token.role === 'DRIVER' && auth.token.driver_id == $driverId))",
        
        "currentLat": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= -90 && newData.val() <= 90)" },
        "currentLng": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= -180 && newData.val() <= 180)" },
        "speed": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 300)" },
        "heading": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 360)" },
        "accuracy": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)" },
        "status": { ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'offline' || newData.val() === 'active')" },
        "lastUpdated": { ".validate": "newData.val() == null || newData.isNumber() || newData.isString()" },
        "timestamp": { ".validate": "newData.val() == null || newData.isNumber() || newData.isString()" },
        "truckId": { ".validate": "newData.val() == null || auth.token.role === 'ADMIN' || auth.token.truck_id == newData.val()" },
        "driverId": { ".validate": "newData.val() == null || auth.token.role === 'ADMIN' || auth.token.driver_id == $driverId" }
      }
    },

    "routes": {
      ".read": "auth != null && auth.token.role === 'ADMIN'",
      "route_$truckId": {
        ".read": "auth != null && (auth.token.role === 'ADMIN' || (auth.token.role === 'DRIVER' && auth.token.truck_id == $truckId))",
        ".write": "auth != null && auth.token.role === 'ADMIN'",
        "stops": {
          "$stopId": {
            ".write": "auth != null && (auth.token.role === 'ADMIN' || (auth.token.role === 'DRIVER' && auth.token.truck_id == $truckId))",
            "status": {
              ".validate": "newData.isString() && (newData.val() === 'PENDING' || newData.val() === 'COMPLETED' || newData.val() === 'SKIPPED' || newData.val() === 'CANCELLED')"
            }
          }
        }
      }
    },

    "settings": {
      ".read": "auth != null && auth.token.role === 'ADMIN'",
      ".write": "auth != null && auth.token.role === 'ADMIN'"
    }
  }
}
